# Copy this file to .env and fill in your real portal credentials.
# .env is git-ignored.

# Login email for the municipal payments portal.
MWU_EMAIL=you@email.com

# Login password for the portal.
MWU_PASSWORD=super-secret-password

# Utility account number, exactly as it appears in the consumption page URL,
# e.g. .../utilities/accounts/consumption/xx-xxx-xx
MWU_ACCOUNT_ID=xx-xxx-xx

# Tenant host portion of the portal URL.
MWU_HOST=xxxx.municipalonlinepayments.com

# Local timezone used to interpret naive timestamps returned by the meter.
MWU_TIMEZONE=America/Chicago

# Optional: how many days to dump in --steps fetch-hourly mode.
MWU_HOURLY_DAYS=2

# Optional: how many days to dump in --steps fetch-daily mode.
MWU_DAILY_DAYS=14
