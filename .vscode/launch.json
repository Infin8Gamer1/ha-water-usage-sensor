{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Live API smoke (all steps)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_api_live.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Live API smoke (login only)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_api_live.py",
            "args": ["--steps", "login", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Live API smoke (login + chart-context, verbose)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_api_live.py",
            "args": ["--steps", "login,chart-context", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Pytest: pure unit tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_api.py",
                "tests/test_utils.py",
                "-p",
                "no:homeassistant",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
